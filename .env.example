# ---------------------------------------------------------------- creator
# One deploy per creator. Must match a folder in creators/.
CREATOR_SLUG=ayria

# ---------------------------------------------------------------- frontend (Vite, baked in at build time)
# Leave the Supabase values empty to run in DEMO MODE (no payments, data stays on the device).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Empty = same origin (the backend serves the frontend). Set when the API runs elsewhere.
VITE_API_URL=
# Web push (optional). Generate with: npx web-push generate-vapid-keys
VITE_VAPID_PUBLIC_KEY=

# ---------------------------------------------------------------- backend (Railway)
PORT=8787
PUBLIC_APP_URL=http://localhost:5173
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# true = Stripe Tax calculates VAT/sales tax (decide with your tax advisor, see blueprint/legal.md)
STRIPE_TAX=false
RESEND_API_KEY=re_...
EMAIL_FROM="Ayria from Glute Era <hello@your-domain.com>"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Protects POST /api/jobs/:job (cron)
CRON_SECRET=change-me
# Comma-separated, only needed if frontend and API are on different origins
ALLOWED_ORIGINS=
